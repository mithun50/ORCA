# Copy to .env and edit. Every setting below has a working default, so an empty
# .env (or no .env at all) still runs.

# --- service ---
ORCA_HOST=127.0.0.1
ORCA_PORT=8017
# Lock this down to the real UI origin before exposing the API anywhere.
ORCA_CORS_ORIGINS=http://localhost:8017,http://127.0.0.1:8017

# --- orchestration ---
# Set this to hand /chat?via=n8n to the n8n router workflow.
ORCA_N8N_BASE=
# Optional shared secret sent as x-orca-token to the n8n webhook.
ORCA_N8N_WEBHOOK_TOKEN=

# --- LLM role routing (all optional, with auto-fallback) ---
# Two jobs, two models. Agentic work wants a reasoning model; natural language
# synthesis wants a fast fluent multilingual one. A role whose provider has no
# key falls back to whatever credentials do exist, then to templates.
# auto | openrouter | gemini | openai | ollama | none   ("ggl" aliases gemini)
ORCA_LLM_PROVIDER=auto

# agentic: intent arbitration and structured judgment -> GLM 5.2 via OpenRouter
ORCA_LLM_AGENTIC_PROVIDER=openrouter
ORCA_LLM_AGENTIC_MODEL=z-ai/glm-5.2

# synthesis: wording and Indian regional language translation.
# Served through OpenRouter so a single key covers every role. Use the direct
# Google API instead by setting provider=gemini and model=gemini-3.8-flash
# together with ORCA_GEMINI_API_KEY.
ORCA_LLM_SYNTHESIS_PROVIDER=openrouter
ORCA_LLM_SYNTHESIS_MODEL=google/gemini-3.8-flash

# OpenRouter (serves GLM 5.2, Gemini, and the Jev decisions endpoint)
ORCA_OPENROUTER_API_KEY=
ORCA_OPENROUTER_BASE=https://openrouter.ai/api/v1
ORCA_OPENROUTER_MODEL=z-ai/glm-5.2

# Google Gemini ("ggl")
ORCA_GEMINI_API_KEY=
ORCA_GEMINI_MODEL=gemini-3.5-flash

# OpenAI-compatible API
ORCA_OPENAI_API_KEY=
ORCA_OPENAI_BASE=https://api.openai.com/v1

# Local, no key. Used only if nothing above is configured.
ORCA_LLM_MODEL=llama3.1:8b
ORCA_OLLAMA_BASE=http://localhost:11434

# --- Jev System-One structured decision engine (optional) ---
# TypeSafe AI's decision model: typed choice / score / noul answers with
# calibrated probabilities, not prose. Two transports, one wire protocol:
#   openrouter -> POST {base}/decisions   model typesafe/jev-1.13
#   typesafe   -> POST {base}/systemone   model jev-latest
# OpenRouter only accepts the versioned slug; `typesafe/jev-latest` 400s there.
# With no key an offline rule emulator runs and labels itself as such.
# Leave the key blank to reuse ORCA_OPENROUTER_API_KEY.
ORCA_JEV_PROVIDER=openrouter
ORCA_JEV_API_KEY=
ORCA_JEV_BASE=https://openrouter.ai/api/alpha
ORCA_JEV_MODEL=typesafe/jev-1.13
ORCA_JEV_TIMEOUT_S=20

# --- Sarvam AI Multimodal Coastal Voice: STT & TTS (optional) ---
# Speech-to-Text (Saaras) & Text-to-Speech (Bulbul) for coastal Indian languages.
# Verified 2026-09-22: bulbul:v1 and v2 are deprecated. Valid TTS models are
# bulbul:v3-beta, bulbul:v3, bulbul:v4-flash, and each accepts its own speaker
# set. bulbul:v3 speakers include aditya, ritu, ashutosh, priya, neha, rahul,
# pooja, rohan. The old `meera` speaker no longer exists.
ORCA_SARVAM_API_KEY=
ORCA_SARVAM_BASE=https://api.sarvam.ai
ORCA_SARVAM_STT_MODEL=saaras:v3
ORCA_SARVAM_TTS_MODEL=bulbul:v3
ORCA_SARVAM_SPEAKER=ritu

# --- IMD ---
# IMD issues API keys on request. Without one, ORCA parses IMD's public
# warning pages instead and says so in the evidence panel.
ORCA_IMD_API_KEY=

# --- risk thresholds, INCOIS/IMD small craft advisory style ---
ORCA_SWH_CAUTION_M=1.5
ORCA_SWH_DANGER_M=2.5
ORCA_WIND_CAUTION_KT=17
ORCA_WIND_DANGER_KT=27
ORCA_GUST_DANGER_KT=34
ORCA_CURRENT_CAUTION_CMS=50
# Hours after which an official forecast cycle is treated as stale.
ORCA_STALE_HOURS=48

# --- retrieval ---
# Set to enable dense retrieval alongside BM25 (needs requirements-optional.txt).
ORCA_QDRANT_URL=
ORCA_CACHE_TTL_S=900
