# Copy to .env and edit. Every setting below has a working default, so an empty
# .env (or no .env at all) still runs.

# --- service ---
ORCA_HOST=127.0.0.1
ORCA_PORT=8017
# Lock this down to the real UI origin before exposing the API anywhere.
ORCA_CORS_ORIGINS=http://localhost:8017,http://127.0.0.1:8017

# --- orchestration ---
# Set this to hand /chat?via=n8n to the n8n router workflow.
ORCA_N8N_BASE=
# Optional shared secret sent as x-orca-token to the n8n webhook.
ORCA_N8N_WEBHOOK_TOKEN=

# --- LLM, all optional ---
# auto | ollama | openai | gemini | none
ORCA_LLM_PROVIDER=auto
ORCA_LLM_MODEL=llama3.1:8b
ORCA_OLLAMA_BASE=http://localhost:11434
ORCA_OPENAI_API_KEY=
ORCA_GEMINI_API_KEY=

# --- IMD ---
# IMD issues API keys on request. Without one, ORCA parses IMD's public
# warning pages instead and says so in the evidence panel.
ORCA_IMD_API_KEY=

# --- risk thresholds, INCOIS/IMD small craft advisory style ---
ORCA_SWH_CAUTION_M=1.5
ORCA_SWH_DANGER_M=2.5
ORCA_WIND_CAUTION_KT=17
ORCA_WIND_DANGER_KT=27
ORCA_GUST_DANGER_KT=34
ORCA_CURRENT_CAUTION_CMS=50
# Hours after which an official forecast cycle is treated as stale.
ORCA_STALE_HOURS=48

# --- retrieval ---
# Set to enable dense retrieval alongside BM25 (needs requirements-optional.txt).
ORCA_QDRANT_URL=
ORCA_CACHE_TTL_S=900
